<?xml version="1.0" encoding="utf-8"?>
<!-- System splash icon: the M in Checkout Neon, 40% of the icon's height, centred.
     Insets are fractions, not dp: the system draws a splash icon into bounds that vary by
     version (160–240dp), and fixed dp insets wider than those bounds leave nothing to draw.
     The art is a small pre-coloured copy (288x384px), so the system splash doesn't decode the
     full-size mark for a 96dp icon. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_mark_neon"
    android:insetLeft="35%"
    android:insetRight="35%"
    android:insetTop="30%"
    android:insetBottom="30%" />

<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+). Nothing in ShopMate may leave the device by backup or transfer:

    - DataStore (files/datastore/) holds the Supabase session. Restored onto another phone it
      would sign that phone in as this cashier.
    - The Room database (shopmate.db) holds sales keyed by client-generated ids. Restored onto a
      second till, both tills hold the same ids; sync's upsert ignores duplicates, so one till's
      sales would be dropped without an error.
    - SharedPreferences may hold supabase-kt's PKCE code verifier.

    android:allowBackup="false" stops cloud backup, but on API 31+ it does NOT stop
    device-to-device transfer. These excludes cover both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

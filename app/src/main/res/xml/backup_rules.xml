<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9–11 (API 28–30). Same rule as data_extraction_rules.xml: the session (DataStore,
    under files/) and the sales database never leave the device. android:allowBackup="false"
    already turns backup off on these versions; the excludes keep it off if that flag is ever
    flipped.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
